# URL pública de produção para geração do QR Code e links compartilháveis (deixe em branco em desenvolvimento local para usar IP da LAN)
PUBLIC_APP_URL=https://dprompt.mermasdigitais.com.br

# Porta do Servidor Fastify + Socket.io
PORT=3001
HOST=0.0.0.0

# Playlist do Spotify incorporada na TV (aceita link normal open.spotify.com/playlist/... ou link embed)
SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/37i9dQZF1DX6J5NfMJS675
VITE_SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/37i9dQZF1DX6J5NfMJS675

# Banco de Dados PostgreSQL 18 (Deixe vazio em dev local para usar o banco local .data/local-db.json)
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/mdx26_desafio_prompt

# Administrador inicial (somente quando ainda não existe um admin no banco).
# Configure a senha fora do Git. A primeira entrada exige troca da senha.
BOOTSTRAP_ADMIN_EMAIL=contatovschneider@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
# Obrigatório em produção: segredo aleatório de pelo menos 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Hierarquia de IA para Avaliação de Intenção Semântica:
# 1º OpenAI GPT -> 2º Groq -> 3º Avaliador Semântico Local Determinístico
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
