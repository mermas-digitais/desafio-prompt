{
  "name": "desafio-prompt-mdx26",
  "version": "1.1.0",
  "private": true,
  "description": "Game Desafio de Prompt - Espaço de IA MDX STEAM 2026 (Mermãs Digitais)",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-module-mocks --test --experimental-test-coverage tests/*.test.ts",
    "dev": "concurrently -k -n SERVER,WEB -c magenta,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/server/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.2",
    "@tailwindcss/vite": "^4.0.9",
    "@tanstack/react-router": "^1.170.46",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "openai": "^4.85.3",
    "pg": "^8.13.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "zod": "^3.24.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.4",
    "sharp": "^0.35.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
